# Copy to .env and fill in real values. .env is gitignored; never commit it.
# Scripts parse .env themselves (they never `source` it), so direnv is optional.

# ── SonarQube (local, opt-in; never needed by CI) ─────────────────────────────
# See docs/sonarqube.md. Only `bash scripts/sonar_scan.sh` reads the token.
#
# Analysis token from your local server: My Account > Security > Generate Token.
# One user token works for every project on that server, so a server shared with
# another repo can reuse its token.
# SONAR_TOKEN=
# Local server URL (default http://localhost:9000). The scan refuses a non-loopback host unless you export
# SONAR_ALLOW_REMOTE=1 in your shell and the host uses https. Setting it in .env has no
# effect, on purpose.
# SONAR_HOST_URL=http://localhost:9000
# Postgres password, only if you start this repo's own server with
# compose.sonarqube.yaml (any long random string). Not needed for a shared server.
# SONAR_DB_PASSWORD=
# Freshness gate for the commit and push hooks. Off unless set to 1.
# SONAR_FRESHNESS_GATE=1
# Commits allowed since the last scan before the commit hook blocks (default 10).
# SONAR_GATE_MAX_COMMITS=10
