# Copy to .env and fill in real values. Never commit .env itself.
# See .gitignore line 143.

# ── App ───────────────────────────────────────────────────────────────────────
# APP_ENV=development
# APP_PORT=3000
# LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ── Auth / Secrets ────────────────────────────────────────────────────────────
# API_KEY=changeme
# JWT_SECRET=changeme

# ── SonarQube (local, opt-in; never needed by CI) ─────────────────────────────
# See docs/sonarqube.md. Only `bash scripts/sonar_scan.sh` reads the token.
# SONAR_TOKEN=
# SONAR_HOST_URL=http://localhost:9000
# Postgres password for compose.sonarqube.yaml (any long random string).
# SONAR_DB_PASSWORD=
# Freshness gate for the commit/push hooks. Off unless set to 1.
# SONAR_FRESHNESS_GATE=1
# SONAR_GATE_MAX_COMMITS=10
