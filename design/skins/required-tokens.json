{
  "$description": "Tokens every skin must define, no more and no fewer, each with the $type it must have. scripts/build-skin-css.mjs checks each design/skins/<id>/tokens.json against this list.",
  "required": [
    { "path": "color.background", "type": "color" },
    { "path": "color.ink", "type": "color" },
    { "path": "color.ink-muted", "type": "color" },
    { "path": "color.ink-faint", "type": "color" },
    { "path": "color.ink-title", "type": "color" },
    { "path": "color.ink-heading", "type": "color" },
    { "path": "color.ink-body", "type": "color" },
    { "path": "color.ink-control", "type": "color" },
    { "path": "color.ink-toggle", "type": "color" },
    { "path": "color.hairline", "type": "color" },
    { "path": "color.accent", "type": "color" },
    { "path": "color.accent-strong", "type": "color" },
    { "path": "color.focus-ring", "type": "color" },
    { "path": "color.chip-text", "type": "color" },
    { "path": "color.chip-background", "type": "color" },
    { "path": "color.glass", "type": "color" },
    { "path": "color.panel", "type": "color" },
    { "path": "color.detail-background", "type": "color" },
    { "path": "color.badge-background", "type": "color" },
    { "path": "color.loading", "type": "color" },
    { "path": "color.scrim", "type": "color" },
    { "path": "color.shadow", "type": "color" },
    { "path": "color.error", "type": "color" },
    { "path": "font.sans", "type": "fontFamily" },
    { "path": "font.display", "type": "fontFamily" },
    { "path": "font.serif", "type": "fontFamily" },
    { "path": "radius.control", "type": "dimension" },
    { "path": "radius.bar", "type": "dimension" },
    { "path": "radius.panel", "type": "dimension" },
    { "path": "blur.bar", "type": "dimension" },
    { "path": "blur.panel", "type": "dimension" },
    { "path": "saturate.bar", "type": "number" },
    { "path": "saturate.panel", "type": "number" },
    { "path": "motion.ease", "type": "cubicBezier" },
    { "path": "motion.panel", "type": "duration" },
    { "path": "motion.fade", "type": "duration" }
  ]
}
