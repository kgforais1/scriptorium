{
  "$description": "Lamplit skin UI tokens (DTCG). Values taken from mockup E (design/mockups/e-lamplit-gallery-ui.html).",
  "color": {
    "$type": "color",
    "background": { "$value": "#0b0705" },
    "ink": { "$value": "#f2e8d6" },
    "ink-muted": { "$value": "#f2e8d694" },
    "ink-faint": { "$value": "#f2e8d65c" },
    "hairline": { "$value": "#ffecce1a" },
    "accent": { "$value": "#d9b36e" },
    "accent-strong": { "$value": "#b8873f" },
    "glass": { "$value": "#1a130d8f" },
    "panel": { "$value": "#19120dcc" },
    "loading": { "$value": "#9b7a48" }
  },
  "font": {
    "$type": "fontFamily",
    "sans": { "$value": ["-apple-system", "BlinkMacSystemFont", "SF Pro Text", "Helvetica Neue", "Helvetica", "Arial", "sans-serif"] },
    "display": { "$value": ["-apple-system", "BlinkMacSystemFont", "SF Pro Display", "Helvetica Neue", "Helvetica", "Arial", "sans-serif"] },
    "serif": { "$value": ["Iowan Old Style", "Hoefler Text", "Palatino", "Palatino Linotype", "Book Antiqua", "Georgia", "serif"] }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": { "value": 10, "unit": "px" } },
    "bar": { "$value": { "value": 16, "unit": "px" } },
    "panel": { "$value": { "value": 18, "unit": "px" } }
  },
  "blur": {
    "$type": "dimension",
    "bar": { "$value": { "value": 22, "unit": "px" } },
    "panel": { "$value": { "value": 28, "unit": "px" } }
  },
  "motion": {
    "ease": { "$type": "cubicBezier", "$value": [0.2, 0.75, 0.15, 1] },
    "panel": { "$type": "duration", "$value": { "value": 650, "unit": "ms" } },
    "fade": { "$type": "duration", "$value": { "value": 350, "unit": "ms" } }
  }
}
