<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The app is ad-hoc signed, and an ad-hoc signature has no team ID, so library validation
       refuses the bundled libpdfium.dylib. Drop this once releases are signed with a Developer
       ID: the bundler then signs Frameworks/ with the same team. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
