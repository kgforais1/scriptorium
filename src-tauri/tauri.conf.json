{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scriptorium",
  "version": "0.1.0",
  "identifier": "dev.scriptorium.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Scriptorium",
        "width": 1280,
        "height": 860
      }
    ],
    "security": {
      "csp": {
        "default-src": [
          "'self'"
        ],
        "img-src": [
          "'self'",
          "asset:",
          "http://asset.localhost",
          "https://asset.localhost",
          "data:",
          "blob:"
        ],
        "style-src": [
          "'self'",
          "'unsafe-inline'"
        ],
        "script-src": [
          "'self'"
        ],
        "connect-src": [
          "'self'",
          "asset:",
          "http://asset.localhost",
          "https://asset.localhost",
          "ipc:",
          "http://ipc.localhost"
        ],
        "object-src": [
          "'none'"
        ],
        "base-uri": [
          "'none'"
        ]
      },
      "devCsp": {
        "default-src": [
          "'self'"
        ],
        "img-src": [
          "'self'",
          "asset:",
          "http://asset.localhost",
          "https://asset.localhost",
          "data:",
          "blob:"
        ],
        "style-src": [
          "'self'",
          "'unsafe-inline'"
        ],
        "script-src": [
          "'self'",
          "'unsafe-inline'"
        ],
        "connect-src": [
          "'self'",
          "asset:",
          "http://asset.localhost",
          "https://asset.localhost",
          "ipc:",
          "http://ipc.localhost",
          "ws://localhost:1420",
          "ws://localhost:1421"
        ],
        "object-src": [
          "'none'"
        ],
        "base-uri": [
          "'none'"
        ]
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/books/*/pages/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
